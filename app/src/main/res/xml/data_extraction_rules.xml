<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup policy for Android 12+ (API 31+). Matches android:allowBackup="false":
    nothing is copied to cloud backup or to a new device. POS data (sales,
    customers) can include personal information, so backup/restore will be
    added deliberately once the app has its own export or sync feature.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
