<?xml version="1.0" encoding="utf-8"?>
<!-- Receipt PDFs, report CSV files and (on Android 9 and older) backups can be shared with other apps; the camera app writes a product photo into capture/. -->
<paths>
    <cache-path name="receipts" path="receipts/" />
    <cache-path name="exports" path="exports/" />
    <cache-path name="capture" path="capture/" />
    <cache-path name="updates" path="updates/" />
    <external-files-path name="backups" path="Auxo/" />
    <external-files-path name="backups_debug" path="Auxo Debug/" />
    <!-- Android 9 and older: backups saved in the public Documents/Auxo folder. -->
    <external-path name="documents_backups" path="Documents/Auxo/" />
    <!-- The debug build keeps its backups in its own folder. -->
    <external-path name="documents_backups_debug" path="Documents/Auxo Debug/" />
    <!-- Debug builds only write these; the folder does not exist in a release build. -->
    <external-files-path name="debuglogs" path="debug-logs/" />
    <files-path name="debuglogs_internal" path="debug-logs/" />
    <!-- Crash and diagnostic reports, shared only when the person chooses. -->
    <files-path name="crash_reports" path="crash-reports/" />
</paths>
